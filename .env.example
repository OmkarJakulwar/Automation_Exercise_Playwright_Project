# Copy this file to .env and fill in your own values. .env is git-ignored.

# Which entry in config/environments.js to use: qa | staging | prod
ENV=prod

# Optional: override the base URL picked from config/environments.js
# BASE_URL=https://automationexercise.com

# Number of parallel workers. Leave empty to let Playwright decide.
# The site is a shared public demo, so keep this modest to avoid rate limiting.
WORKERS=4

# A long-lived account for tests that just need "some" existing user.
# Most tests create their own throwaway user through the API instead.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_NAME=
